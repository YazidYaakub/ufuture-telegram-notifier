# =============================================================================
#  uFuture Telegram Notifier: your settings
# =============================================================================
#
#  HOW TO USE THIS FILE
#  1. Make a copy of this file and name the copy exactly:  .env
#     (just ".env", nothing before the dot, no ".txt" at the end)
#  2. Fill in the 5 values in PART 1 below. That's all most people need.
#  3. Save the file. Keep it private: it contains your UiTM password.
#
#  RULES FOR WRITING VALUES
#  - Write each value right after the "=" sign, on the same line.
#  - No spaces around the "=" sign.
#  - Lines starting with "#" are notes and are ignored.
#  - Wrap your password in single quotes, like  UFUTURE_PASSWORD='myPa$$word!'
#    so special characters ($ ! # & spaces) are read correctly.
#
#  Your password and tokens stay on YOUR computer. Nothing in this file is
#  sent anywhere except: your UiTM login goes to UiTM, your bot token to Telegram.
#
# =============================================================================


# =============================================================================
#  PART 1: REQUIRED. Fill in all 5.
# =============================================================================

# Your UiTM student ID, the same one you use to log in to uFuture.
# Example: UFUTURE_USERNAME=2023123456
UFUTURE_USERNAME=

# Your uFuture password. Keep the single quotes around it.
# Example: UFUTURE_PASSWORD='MySecret#2026'
# Tip: if the app ever says "UiTM login was rejected", fix this value first.
# It does not retry a wrong password, so your account won't get locked.
UFUTURE_PASSWORD=''

# The "token" of YOUR OWN Telegram bot. Each person needs their own bot.
# How to get it (2 minutes):
#   1. In Telegram, search for  @BotFather  (blue tick) and open it.
#   2. Send:  /newbot
#   3. Choose a name (e.g. "My uFuture"), then a username ending in "bot"
#      (e.g. "ali_ufuture_bot").
#   4. BotFather replies with a token. Copy it and paste it here.
# It looks like: 1234567890:AAH-xYzAbCdEfGhIjKlMnOpQrStUvWxYz12
# Then open your new bot in Telegram and press START (or send /start),
# otherwise the bot is not allowed to message you.
TELEGRAM_BOT_TOKEN=

# The Telegram chat where your notifications should go: your own chat ID.
# How to get it:
#   1. In Telegram, search for  @userinfobot  and press START.
#   2. It replies with your "Id", a number like 123456789. Paste it here.
# Example: TELEGRAM_CHAT_ID=123456789
TELEGRAM_CHAT_ID=

# Who may use the bot's buttons and commands. Put your own ID here
# (the same number as TELEGRAM_CHAT_ID) so nobody else can use YOUR bot,
# even if they find it. For several people, separate with commas: 111,222
# Example: TELEGRAM_ALLOWED_USER_IDS=123456789
TELEGRAM_ALLOWED_USER_IDS=


# =============================================================================
#  PART 2: OPTIONAL FEATURES. The defaults are fine; change only if you want.
# =============================================================================

# Reply to forum posts from Telegram (with files). You always see a preview
# and must tap "Send to UiTM" before anything is posted. Your reply is posted
# under YOUR name on uFuture, visible to your lecturer and classmates.
#   false = off (default, safest)    true = on
UFUTURE_REPLY_ENABLED=false

# Send lecturers' files (slides, PDFs, images) straight into Telegram.
#   true = on (default)    false = only show the file names
TELEGRAM_SEND_ATTACHMENTS=true

# Files bigger than this many megabytes are not sent; you get an
# "Open in UiTM" link instead. Telegram's own limit is 50.
ATTACHMENT_MAX_MB=20

# Classmates' "thank you Dr" replies arrive silently (no sound or vibration).
# Lecturer posts, new topics and replies to YOUR posts still make a sound.
#   true = silent classmates (default)    false = everything makes a sound
TELEGRAM_SILENT_CLASSMATE_REPLIES=true

# Message style.
#   digest  = one message per important post + one silent summary (default)
#   classic = one message per changed week (older style)
TELEGRAM_LAYOUT=digest

# If the app fails this many times in a row (about 10 minutes each), it sends
# you a warning in Telegram, and an "all good again" message when it recovers.
#   0 = never warn
SCRAPER_ALERT_AFTER=3

# Your time zone as hours ahead of UTC, for times shown in Telegram.
#   8 = Malaysia (default)
LOCAL_UTC_OFFSET_HOURS=8


# =============================================================================
#  PART 3: ADVANCED. Leave these alone unless you know you need them.
#  They are switched off with "#"; remove the "#" to change one.
# =============================================================================

# How many topic pages to read per check (keeps load on UiTM low).
# TOPIC_DETAIL_LIMIT=20

# "changed" = only read topics in weeks that changed (default, gentle on UiTM)
# "all"     = re-read topics every check
# TOPIC_DETAIL_MODE=changed

# How many times to retry when UiTM or the internet doesn't answer,
# and how many seconds to wait between tries.
# REQUEST_RETRIES=3
# REQUEST_BACKOFF_SECONDS=5

# Most files sent per check; the rest follow on the next checks.
# ATTACHMENT_MAX_PER_RUN=5

# Most topics listed in one message or summary.
# TELEGRAM_MAX_TOPICS_PER_MESSAGE=8

# Minimum seconds between two replies you post to UiTM.
# REPLY_MIN_INTERVAL_SECONDS=60

# Seconds to wait for UiTM when posting a reply.
# REPLY_POST_TIMEOUT_SECONDS=45

# Hours an unsent reply draft stays open (saved drafts last 7 days).
# TELEGRAM_REPLY_DRAFT_TTL_HOURS=24

# Hours that file buttons keep working (topic buttons never expire).
# TELEGRAM_ACTION_TTL_HOURS=720

# Turn the interactive bot (buttons, commands, replies) off and only get
# plain notifications.   true = on (default)   false = off
# TELEGRAM_INTERACTIVE_BOT=true

# Buttons in messages.   true = on (default)   false = no buttons
# TELEGRAM_INLINE_BUTTONS=true

# Read topic pages for post details.   true = on (default)
# SCRAPE_TOPIC_DETAILS=true

# Maximum seconds one check may take before it's stopped.
# SCRAPER_TIMEOUT_SECONDS=300

# Test mode: print messages in the log instead of sending them.
# DRY_RUN=false

# Settings for the "classic" layout only.
# INCLUDE_REPLY_EXCERPTS=true
# REPLY_EXCERPT_LENGTH=160
# DETAIL_EXCERPT_LENGTH=700
# TELEGRAM_DEDUP_REPLIES=true
# TELEGRAM_SHORT_NAMES=true
# TELEGRAM_MEDIA_BUTTONS=true
